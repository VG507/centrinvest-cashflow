# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=hackrnd_db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/hackrnd_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# External AI Service (Optional LLM synthesis)
GEMINI_API_KEYS=
